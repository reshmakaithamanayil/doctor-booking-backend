NODE_ENV=development
PORT=5000

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=doctor_booking
DB_USER=postgres
DB_PASSWORD=postgres
# Connections per app instance
DB_POOL_MAX=10
# production only
DB_SSL=false

# JWT - use a random string of 32+ chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Security / HTTP
# Comma-separated allowed origins (unset = allow all, dev only)
CORS_ORIGIN=
# Set to 1 when running behind one reverse proxy / load balancer
TRUST_PROXY=
# Requests per 15 min per IP (all /api routes, and login/register)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Set to false to hide Swagger UI (/api-docs)
ENABLE_API_DOCS=true

# Seeder: initial admin account (change before seeding a shared environment)
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin@123

# Used only the very first time, before an admin has configured
# a clinic timezone in the database (via the seeder / API).
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata
